# Copy to .env and fill in. Vite only exposes vars prefixed VITE_ to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Worker base URL (see cloudflare-worker/README.md) — powers
# video uploads (POST /presign) and newsletter subscribe (POST /newsletter/subscribe).
VITE_UPLOAD_WORKER_URL=

# EmailJS — only used for the contact form. https://dashboard.emailjs.com
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=

# Newsletter subscribe does NOT use EmailJS — it goes through the Worker to
# Brevo instead, so you can actually send campaigns later. Set BREVO_API_KEY
# and BREVO_LIST_ID as Worker secrets (see cloudflare-worker/README.md),
# not here — they must never reach the browser.

# Leave blank until you buy a domain — robots.txt/sitemap.xml and canonical
# tags fall back to the Vercel URL automatically (see
# scripts/generate-seo-files.mjs). Once you have a domain, set it here AND
# in Vercel's project env vars, and everything updates on the next build.
VITE_APP_URL=
VITE_METADATA_TITLE=
VITE_WEBSITE_CONTACT_EMAIL=
